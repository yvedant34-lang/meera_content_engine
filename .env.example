# meera_content_engine: local secrets. NEVER commit (in .gitignore). See KEYS.md for where each came from.

# ── Telegram (Vy supplies) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# ── Gemini (reused from flix-trip, verified live 25 Sep) ──
GEMINI_API_KEY=

# ── Anthropic (Vy supplies, needed from B1) ──
ANTHROPIC_API_KEY=

# ── Supabase (URL + service key filled in step 0.5 after project is created) ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_ORG_ID=
SUPABASE_ACCESS_TOKEN=

# ── GitHub (reused from flix-trip, scope: repo) ──
GITHUB_USERNAME=
GITHUB_TOKEN=
GITHUB_REPO_URL=

# ── Vercel (filled in step 0.7) ──
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_ORG_ID=
VERCEL_URL_PROD=

# ── App config ──
SCORE_THRESHOLD=6
DRAFT_MODEL_PROVIDER=gemini

# ── Optional model overrides (defaults in lib/gemini.js and lib/anthropic.js) ──
# GEMINI_FLASH_MODEL=gemini-3.8-flash
# GEMINI_DRAFT_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite
# CLAUDE_DRAFT_MODEL=claude-opus-5
# DRAFT_MODEL_PROVIDER accepts: gemini | anthropic | both (both = model comparison)
